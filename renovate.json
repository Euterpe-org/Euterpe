{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "baseBranchPatterns": [
    "dev"
  ],
  "useBaseBranchConfig": "merge",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track NuGet versions from *Version properties in Directory.Packages.props",
      "managerFilePatterns": [
        "^Directory\\.Packages\\.props$"
      ],
      "matchStrings": [
        "<(?<depName>[A-Za-z0-9_.-]+)Version>(?<currentValue>[^<]+)</[A-Za-z0-9_.-]+Version>"
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "nuget",
        "custom.regex"
      ],
      "groupName": "All .NET dependencies",
      "groupSlug": "dotnet-deps",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    }
  ]
}