<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MuseDashModTools.ViewModels.Panels.Logging"
    x:Class="MuseDashModTools.Views.Panels.Logging.LogViewerPanel"
    x:DataType="vm:LogViewerPanelViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:LogViewerPanelViewModel />
    </Design.DataContext>

    <ListBox
        ItemsSource="{Binding LogContents}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <TextBlock
                    Text="{Binding}"
                    TextWrapping="Wrap" />
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

</UserControl>