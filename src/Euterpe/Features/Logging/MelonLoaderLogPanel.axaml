<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Euterpe.Features.Logging"
    x:Class="Euterpe.Features.Logging.MelonLoaderLogPanel"
    x:DataType="vm:MelonLoaderLogPanelViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MelonLoaderLogPanelViewModel />
    </Design.DataContext>

    <TextBlock
        HorizontalAlignment="Center"
        TextAlignment="Center"
        VerticalAlignment="Center">
        MelonLoader Log Panel still work in progress...
    </TextBlock>
</UserControl>