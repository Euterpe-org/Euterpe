<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:e="https://github.com/Euterpe-org/Euterpe"
    xmlns:loc="https://github.com/Euterpe-org/Euterpe/Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:Euterpe.Features.Charting"
    x:Class="Euterpe.Features.Charting.EpkEditorPanel"
    x:DataType="vm:EpkEditorPanelViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:EpkEditorPanelViewModel />
    </Design.DataContext>

    <Grid
        Margin="16"
        RowDefinitions="Auto,*">

        <!--  Action bar  -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            Margin="0,0,0,12">
            <Button
                Grid.Column="0"
                Command="{Binding BackCommand}"
                Content="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Back}}" />
            <Button
                Grid.Column="2"
                Classes="Primary"
                Command="{Binding SaveCommand}"
                Content="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Save}}" />
        </Grid>

        <ScrollViewer
            Grid.Row="1">
            <StackPanel
                Classes="ContentListRoot">

                <e:LabeledSection
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_Name}}">
                    <TextBox
                        Text="{Binding Name}" />
                </e:LabeledSection>

                <e:LabeledSection
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_NameRomanized}}">
                    <TextBox
                        Text="{Binding NameRomanized}" />
                </e:LabeledSection>

                <e:LabeledSection
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_Author}}">
                    <TextBox
                        Text="{Binding Author}" />
                </e:LabeledSection>

                <e:LabeledSection
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_Description}}">
                    <TextBox
                        AcceptsReturn="True"
                        Text="{Binding Description}"
                        TextWrapping="Wrap" />
                </e:LabeledSection>

                <!--  Base BPM is always editable; the range toggle reveals min/max (variable tempo)  -->
                <e:LabeledSection
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_Bpm}}">
                    <StackPanel
                        Spacing="8">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">
                            <u:NumericIntUpDown
                                Maximum="999"
                                Minimum="0"
                                Value="{Binding Bpm}"
                                Width="140" />
                            <ToggleSwitch
                                Content="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Bpm_Range}}"
                                IsChecked="{Binding IsBpmRange, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel
                            IsVisible="{Binding IsBpmRange}"
                            Orientation="Horizontal"
                            Spacing="8">
                            <u:NumericIntUpDown
                                Maximum="999"
                                Minimum="0"
                                Value="{Binding BpmMin}"
                                Width="120" />
                            <TextBlock
                                Text="–"
                                VerticalAlignment="Center" />
                            <u:NumericIntUpDown
                                Maximum="999"
                                Minimum="0"
                                Value="{Binding BpmMax}"
                                Width="120" />
                        </StackPanel>
                    </StackPanel>
                </e:LabeledSection>

                <e:LabeledSection
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_Scene}}">
                    <TextBox
                        Text="{Binding Scene}" />
                </e:LabeledSection>

                <e:LabeledSection
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_SceneEgg}}">
                    <TextBox
                        Text="{Binding SceneEgg}" />
                </e:LabeledSection>

                <e:LabeledSection
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_BackgroundVideoOpacity}}">
                    <u:NumericFloatUpDown
                        Maximum="1"
                        Minimum="0"
                        Step="0.1"
                        Value="{Binding BackgroundVideoOpacity}"
                        Width="140" />
                </e:LabeledSection>

                <e:LabeledSection
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_SafeForStreamer}}">
                    <ToggleSwitch
                        IsChecked="{Binding SafeForStreamer, Mode=TwoWay}" />
                </e:LabeledSection>

                <e:LabeledSection
                    Description="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_SearchKeywords_Description}}"
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_SearchKeywords}}">
                    <TextBox
                        Text="{Binding SearchKeywordsText}" />
                </e:LabeledSection>

                <!--  Per-difficulty rating + charters  -->
                <e:LabeledSection
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_Difficulties}}">
                    <ItemsControl
                        ItemsSource="{Binding Maps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate
                                x:DataType="vm:DifficultyEditViewModel">
                                <Grid
                                    ColumnDefinitions="100,90,*"
                                    Margin="0,0,0,8">
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding DifficultyName.Value}"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        PlaceholderText="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Map_Rating}}"
                                        Text="{Binding Rating}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        PlaceholderText="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Map_Charters}}"
                                        Text="{Binding ChartersText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </e:LabeledSection>

                <!--  Files are read-only; Refresh re-reads them from the chart folder  -->
                <e:LabeledSection
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_Files}}">
                    <StackPanel
                        Spacing="8">
                        <Button
                            Command="{Binding RefreshFilesCommand}"
                            Content="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Files_Refresh}}"
                            HorizontalAlignment="Left" />
                        <ItemsControl
                            ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate
                                    x:DataType="vm:EpkFileEntry">
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        Margin="0,0,0,2">
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Opacity="0.6"
                                            Text="{Binding Size, StringFormat='{}{0:N0} B'}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </e:LabeledSection>

                <!--  Hidden-difficulty (map4) settings; only present when the chart has a Hidden map  -->
                <e:LabeledSection
                    IsVisible="{Binding HasHiddenDifficulty}"
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_HideMode}}">
                    <TextBox
                        Text="{Binding HideMode}" />
                </e:LabeledSection>

                <e:LabeledSection
                    IsVisible="{Binding HasHiddenDifficulty}"
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_HideRatingOverride}}">
                    <TextBox
                        Text="{Binding HideRatingOverride}" />
                </e:LabeledSection>

                <e:LabeledSection
                    IsVisible="{Binding HasHiddenDifficulty}"
                    Title="{Localize {x:Static loc:XAMLLiteral.EpkEditor_Field_HideMessage}}">
                    <TextBox
                        Text="{Binding HideMessage}" />
                </e:LabeledSection>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>