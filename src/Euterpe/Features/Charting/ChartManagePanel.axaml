<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Euterpe.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:e="https://github.com/Euterpe-org/Euterpe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Euterpe.Models.Charts"
    xmlns:vm="using:Euterpe.Features.Charting"
    x:Class="Euterpe.Features.Charting.ChartManagePanel"
    x:DataType="vm:ChartManagePanelViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:ChartManagePanelViewModel />
    </Design.DataContext>

    <Grid
        Margin="16"
        RowDefinitions="Auto,*">

        <!--  Top bar: source + search + sort + reset  -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto,Auto,Auto"
            Margin="0,0,0,12">
            <ComboBox
                Grid.Column="0"
                MinWidth="110"
                SelectedIndex="{Binding SelectedChartSourceIndex}">
                <ComboBoxItem>Online</ComboBoxItem>
                <ComboBoxItem>Offline</ComboBoxItem>
            </ComboBox>

            <TextBox
                Grid.Column="1"
                Margin="12,0"
                PlaceholderText="Search  (name, author, charter)"
                Text="{Binding SearchText}" />

            <ComboBox
                Grid.Column="2"
                MinWidth="140"
                SelectedIndex="{Binding SortField}"
                ToolTip.Tip="Sort by">
                <ComboBoxItem>Name</ComboBoxItem>
                <ComboBoxItem>Author</ComboBoxItem>
                <ComboBoxItem>BPM</ComboBoxItem>
                <ComboBoxItem>Rating</ComboBoxItem>
                <ComboBoxItem>Date added</ComboBoxItem>
                <ComboBoxItem>Date updated</ComboBoxItem>
                <ComboBoxItem>Difficulties</ComboBoxItem>
            </ComboBox>

            <ToggleButton
                Grid.Column="3"
                IsChecked="{Binding SortDescending}"
                Margin="8,0,0,0"
                ToolTip.Tip="Descending"
                Width="40">
                <TextBlock Text="{Binding SortDescending, Converter={x:Static converters:FuncValueConverters.SortDirectionConverter}}" />
            </ToggleButton>

            <Button
                Grid.Column="4"
                Command="{Binding ResetFiltersCommand}"
                Content="Reset"
                Margin="8,0,0,0" />
        </Grid>

        <!--  Body: filter rail + tiled grid  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="220,*">

            <!--  Filter rail  -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource SecondaryCardColor}"
                CornerRadius="8"
                Margin="0,0,12,0"
                Padding="12">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="Difficulty" />
                            <CheckBox Content="Easy" IsChecked="{Binding ShowEasy}" />
                            <CheckBox Content="Hard" IsChecked="{Binding ShowHard}" />
                            <CheckBox Content="Master" IsChecked="{Binding ShowMaster}" />
                            <CheckBox Content="Hidden" IsChecked="{Binding ShowHidden}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="Rating" />
                            <Grid ColumnDefinitions="*,Auto,*">
                                <NumericUpDown Grid.Column="0" Increment="1" FormatString="0.#" Maximum="99" Minimum="0" Value="{Binding RatingMin}" />
                                <TextBlock Grid.Column="1" Margin="6,0" Text="–" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="2" Increment="1" FormatString="0.#" Maximum="99" Minimum="0" Value="{Binding RatingMax}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="BPM" />
                            <Grid ColumnDefinitions="*,Auto,*">
                                <NumericUpDown Grid.Column="0" Increment="10" FormatString="0" Maximum="999" Minimum="0" Value="{Binding BpmMin}" />
                                <TextBlock Grid.Column="1" Margin="6,0" Text="–" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="2" Increment="10" FormatString="0" Maximum="999" Minimum="0" Value="{Binding BpmMax}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="Scene" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Scenes}" PlaceholderText="Any" SelectedItem="{Binding SelectedScene}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <CheckBox Content="Streamer safe" IsChecked="{Binding StreamerSafeOnly}" />
                            <CheckBox Content="Has video" IsChecked="{Binding HasVideoOnly}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  Tiled chart grid (4 per row at default window size)  -->
            <ScrollViewer Grid.Column="1">
                <ItemsControl ItemsSource="{Binding Charts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChartDto">
                            <Border
                                Background="{DynamicResource SecondaryCardColor}"
                                CornerRadius="10"
                                Margin="0,0,12,12"
                                Padding="8">
                                <StackPanel Spacing="6">
                                    <!--  Cover with hover play/pause + now-playing indicator  -->
                                    <Panel>
                                        <e:AsyncImage
                                            Background="{Binding Manifest.Meta.CoverDominantColor, Converter={x:Static converters:FuncValueConverters.HexColorToBrushConverter}}"
                                            ClipToBounds="True"
                                            CornerRadius="8"
                                            Height="150"
                                            HorizontalAlignment="Stretch"
                                            Source="{Binding CoverPath}"
                                            Stretch="UniformToFill" />

                                        <!--  Now playing indicator  -->
                                        <Border
                                            Background="#CC1DB954"
                                            CornerRadius="6"
                                            HorizontalAlignment="Left"
                                            Margin="6"
                                            Padding="6,2"
                                            VerticalAlignment="Top">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static converters:FuncValueConverters.ChartIsPlayingConverter}">
                                                    <Binding Path="FolderName" />
                                                    <Binding Path="$parent[UserControl].DataContext.CurrentlyPlaying" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <TextBlock FontSize="11" Foreground="White" Text="♪" />
                                        </Border>

                                        <!--  Hover play / pause  -->
                                        <Button
                                            Background="#B3000000"
                                            Command="{Binding $parent[UserControl].DataContext.TogglePlayCommand}"
                                            CommandParameter="{Binding}"
                                            CornerRadius="20"
                                            Foreground="White"
                                            HorizontalAlignment="Center"
                                            IsVisible="{Binding $parent[Border].IsPointerOver}"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Width="40"
                                            Height="40">
                                            <Button.Content>
                                                <MultiBinding Converter="{x:Static converters:FuncValueConverters.ChartPlayGlyphConverter}">
                                                    <Binding Path="FolderName" />
                                                    <Binding Path="$parent[UserControl].DataContext.CurrentlyPlaying" />
                                                </MultiBinding>
                                            </Button.Content>
                                        </Button>
                                    </Panel>

                                    <!--  Title / author  -->
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        Text="{Binding Manifest.Meta.Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding Manifest.Meta.Name}" />
                                    <TextBlock
                                        FontSize="12"
                                        MaxLines="1"
                                        Opacity="0.7"
                                        Text="{Binding Manifest.Meta.Author}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!--  Meta row: bpm + scene  -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.85"
                                            Text="{Binding Manifest.Meta, Converter={x:Static converters:FuncValueConverters.ChartBpmConverter}, StringFormat='♪ {0}'}" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.6"
                                            Text="{Binding Manifest.Meta.Scene}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!--  Difficulty icons with rating overlaid  -->
                                    <ItemsControl ItemsSource="{Binding ., Converter={x:Static converters:FuncValueConverters.ChartDifficultyBadgesConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DifficultyBadge">
                                                <Panel Height="30" Width="30">
                                                    <Image
                                                        Source="{Binding Difficulty, Converter={x:Static converters:FuncValueConverters.DifficultyIconConverter}}"
                                                        Stretch="Uniform" />
                                                    <Border
                                                        Background="#99000000"
                                                        CornerRadius="4"
                                                        HorizontalAlignment="Center"
                                                        Padding="3,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Foreground="White"
                                                            Text="{Binding Rating}" />
                                                    </Border>
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  Uploader  -->
                                    <TextBlock
                                        FontSize="11"
                                        IsVisible="{Binding Manifest.Meta.Uploader, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Opacity="0.55"
                                        Text="{Binding Manifest.Meta.Uploader.Nickname, StringFormat='by {0}'}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
