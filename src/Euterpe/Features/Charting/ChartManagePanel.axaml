<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Euterpe.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:e="https://github.com/Euterpe-org/Euterpe"
    xmlns:loc="https://github.com/Euterpe-org/Euterpe/Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Euterpe.Models.Charts"
    xmlns:vm="using:Euterpe.Features.Charting"
    x:Class="Euterpe.Features.Charting.ChartManagePanel"
    x:DataType="vm:ChartManagePanelViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:ChartManagePanelViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border#DropOverlay">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.DragOver &gt; Border#DropOverlay">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <Grid
        e:DropZone.IsActive="True"
        Margin="16"
        RowDefinitions="Auto,*">

        <Interaction.Behaviors>
            <FilesDropBehavior Command="{Binding ImportChartsCommand}" />
        </Interaction.Behaviors>

        <!--  Drag-over highlight overlay  -->
        <Border
            x:Name="DropOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            BorderBrush="{DynamicResource SemiBlue6}"
            BorderThickness="2"
            CornerRadius="8"
            IsHitTestVisible="False" />

        <!--  Top bar: source + search + sort + reset  -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto,Auto,Auto"
            Margin="0,0,0,12">
            <ComboBox
                Grid.Column="0"
                MinWidth="110"
                SelectedIndex="{Binding SelectedChartSourceIndex}">
                <ComboBoxItem Content="{Localize {x:Static loc:XAMLLiteral.ChartSource_Online}}" />
                <ComboBoxItem Content="{Localize {x:Static loc:XAMLLiteral.ChartSource_Offline}}" />
            </ComboBox>

            <TextBox
                Grid.Column="1"
                Margin="12,0"
                PlaceholderText="{Localize {x:Static loc:XAMLLiteral.SearchBarPlaceholder_Chart}}"
                Text="{Binding SearchText}" />

            <ComboBox
                Grid.Column="2"
                MinWidth="140"
                SelectedIndex="{Binding SortField}"
                ToolTip.Tip="{Localize {x:Static loc:XAMLLiteral.ChartManage_SortBy}}">
                <ComboBoxItem Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_Sort_Name}}" />
                <ComboBoxItem Content="{Localize {x:Static loc:XAMLLiteral.ModInfo_Author}}" />
                <ComboBoxItem Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_Bpm}}" />
                <ComboBoxItem Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_Rating}}" />
                <ComboBoxItem Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_Sort_DateAdded}}" />
                <ComboBoxItem Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_Sort_DateUpdated}}" />
                <ComboBoxItem Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_Sort_Maps}}" />
                <ComboBoxItem Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_Sort_FileSize}}" />
            </ComboBox>

            <ToggleButton
                Grid.Column="3"
                IsChecked="{Binding SortDescending}"
                Margin="8,0,0,0"
                ToolTip.Tip="{Localize {x:Static loc:XAMLLiteral.ChartManage_Descending}}"
                Width="40">
                <TextBlock Text="{Binding SortDescending, Converter={x:Static converters:FuncValueConverters.SortDirectionConverter}}" />
            </ToggleButton>

            <Button
                Grid.Column="4"
                Command="{Binding ResetFiltersCommand}"
                Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_Reset}}"
                Margin="8,0,0,0" />
        </Grid>

        <!--  Body: filter rail + tiled grid  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="220,*">

            <!--  Filter rail  -->
            <!--  Right padding lives on the scroll content, not the rail: the freed 12px is a gutter
                  the overlay scrollbar floats in, so it never covers content, while without a
                  scrollbar the content keeps symmetric 12px margins at any window size.  -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource SecondaryCardColor}"
                CornerRadius="8"
                Margin="0,0,12,0"
                Padding="12,12,0,12">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0">
                    <StackPanel Margin="0,0,12,0" Spacing="14">
                        <!--  Charts are browsed/downloaded on the web; flashy CTA card to send users there  -->
                        <Button
                            Classes="Transparent Card"
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="https://euterpe-org.com/charts"
                            ToolTip.Tip="https://euterpe-org.com/charts">
                            <Button.Styles>
                                <Style Selector="Button:pointerover Border.Hover">
                                    <Setter Property="Background" Value="#B32E29" />
                                    <Setter Property="RenderTransform" Value="scale(1.02)" />
                                </Style>
                            </Button.Styles>
                            <Border Classes="Hover">
                                <StackPanel>
                                    <TextBlock
                                        Classes="CardTitle"
                                        Text="{Localize {x:Static loc:XAMLLiteral.ChartManage_GetCharts_Title}}">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Offset="0" Color="#FF9966" />
                                                <GradientStop Offset="1" Color="#FF5E62" />
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock
                                        Classes="CardDesc"
                                        Text="{Localize {x:Static loc:XAMLLiteral.ChartManage_GetCharts_Description}}" />
                                </StackPanel>
                            </Border>
                        </Button>

                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="{Localize {x:Static loc:XAMLLiteral.ChartManage_Filter_Difficulty}}" />
                            <CheckBox Content="{Localize {x:Static loc:XAMLLiteral.ChartDifficulty_Easy}}" IsChecked="{Binding ShowEasy}" />
                            <CheckBox Content="{Localize {x:Static loc:XAMLLiteral.ChartDifficulty_Hard}}" IsChecked="{Binding ShowHard}" />
                            <CheckBox Content="{Localize {x:Static loc:XAMLLiteral.ChartDifficulty_Master}}" IsChecked="{Binding ShowMaster}" />
                            <CheckBox Content="{Localize {x:Static loc:XAMLLiteral.ChartDifficulty_Hidden}}" IsChecked="{Binding ShowHidden}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="{Localize {x:Static loc:XAMLLiteral.ChartManage_Rating}}" />
                            <Grid ColumnDefinitions="*,Auto,*">
                                <NumericUpDown Grid.Column="0" Increment="1" FormatString="0" Maximum="12" Minimum="1" Value="{Binding RatingMin}" />
                                <TextBlock Grid.Column="1" Margin="6,0" Text="–" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="2" Increment="1" FormatString="0" Maximum="12" Minimum="1" Value="{Binding RatingMax}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="{Localize {x:Static loc:XAMLLiteral.ChartManage_Bpm}}" />
                            <Grid ColumnDefinitions="*,Auto,*">
                                <NumericUpDown Grid.Column="0" Increment="10" FormatString="0" Maximum="999" Minimum="0" Value="{Binding BpmMin}" />
                                <TextBlock Grid.Column="1" Margin="6,0" Text="–" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="2" Increment="10" FormatString="0" Maximum="999" Minimum="0" Value="{Binding BpmMax}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <CheckBox Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_Filter_StreamerSafe}}" IsChecked="{Binding StreamerSafeOnly}" />
                            <CheckBox Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_Filter_HasVideo}}" IsChecked="{Binding HasVideoOnly}" />
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <!--  Maintenance actions, pinned below the scrolling filters  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,12,12,0"
                        Spacing="6">
                        <Button
                            Command="{Binding UpdateAllChartsCommand}"
                            Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_UpdateAll}}"
                            HorizontalAlignment="Stretch" />
                        <Button
                            Command="{Binding MigrateCustomAlbumsCommand}"
                            Content="{Localize {x:Static loc:XAMLLiteral.ChartManage_MigrateMdm}}"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Chart grid: fixed-width cards that wrap, so the column count flows with window width (≈4 at the default size, more when wider) instead of locking to 4  -->
            <ScrollViewer Grid.Column="1">
                <ItemsControl ItemsSource="{Binding Charts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChartDto">
                            <Border
                                Background="{DynamicResource SecondaryCardColor}"
                                CornerRadius="10"
                                Margin="0,0,12,12"
                                Padding="8"
                                Width="180">
                                <Border.Styles>
                                    <!--  Hovering the card swaps the size text for the delete button in the same slot  -->
                                    <Style Selector="Border:pointerover TextBlock.sizeText">
                                        <Setter Property="Opacity" Value="0" />
                                    </Style>
                                </Border.Styles>
                                <StackPanel Spacing="6">
                                    <!--  Cover: the whole cover toggles play/pause; mask + button appear together  -->
                                    <Button
                                        Command="{Binding $parent[UserControl].DataContext.TogglePlayCommand}"
                                        CommandParameter="{Binding}"
                                        Focusable="False"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="0"
                                        VerticalContentAlignment="Stretch">
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="CornerRadius" Value="8" />
                                            </Style>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                            </Style>
                                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                            <!--  Hover enlarges the center play/pause button  -->
                                            <Style Selector="Button:pointerover Border.playDisc">
                                                <Setter Property="RenderTransform" Value="scale(1.12)" />
                                            </Style>
                                        </Button.Styles>

                                        <!--  1:1 square cover container (height tracks width)  -->
                                        <Panel Height="{Binding $self.Bounds.Width}">
                                            <Border
                                                ClipToBounds="True"
                                                CornerRadius="8">
                                                <e:AsyncImage
                                                    Background="{Binding Manifest.Meta.CoverDominantColor, Converter={x:Static converters:FuncValueConverters.HexColorToBrushConverter}}"
                                                    HorizontalAlignment="Stretch"
                                                    Source="{Binding CoverPath}"
                                                    Stretch="UniformToFill" />
                                            </Border>

                                            <!--  Mask + play/pause button (bound together via overlay opacity)  -->
                                            <Border
                                                Background="#40000000"
                                                CornerRadius="8"
                                                IsHitTestVisible="False">
                                                <Border.Opacity>
                                                    <MultiBinding Converter="{x:Static converters:FuncValueConverters.ChartOverlayOpacityConverter}">
                                                        <Binding Path="FolderName" />
                                                        <Binding Path="$parent[UserControl].DataContext.CurrentlyPlaying" />
                                                        <Binding Path="$parent[Button].IsPointerOver" />
                                                    </MultiBinding>
                                                </Border.Opacity>
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                                                    </Transitions>
                                                </Border.Transitions>

                                                <Border
                                                    Background="#26FFFFFF"
                                                    Classes="playDisc"
                                                    CornerRadius="20"
                                                    Height="40"
                                                    HorizontalAlignment="Center"
                                                    RenderTransform="scale(1)"
                                                    RenderTransformOrigin="50%,50%"
                                                    VerticalAlignment="Center"
                                                    Width="40">
                                                    <Border.Transitions>
                                                        <Transitions>
                                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                                                        </Transitions>
                                                    </Border.Transitions>
                                                    <PathIcon
                                                        Foreground="White"
                                                        Height="14"
                                                        Width="14">
                                                        <PathIcon.Data>
                                                            <MultiBinding Converter="{x:Static converters:FuncValueConverters.ChartPlayIconConverter}">
                                                                <Binding Path="FolderName" />
                                                                <Binding Path="$parent[UserControl].DataContext.CurrentlyPlaying" />
                                                            </MultiBinding>
                                                        </PathIcon.Data>
                                                    </PathIcon>
                                                </Border>
                                            </Border>

                                            <!--  Difficulty + rating badges, overlaid top-right (laid out toward the left)  -->
                                            <ItemsControl
                                                HorizontalAlignment="Right"
                                                IsHitTestVisible="False"
                                                ItemsSource="{Binding ., Converter={x:Static converters:FuncValueConverters.ChartDifficultyBadgesConverter}}"
                                                Margin="6"
                                                VerticalAlignment="Top">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="3" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DifficultyBadge">
                                                        <Panel
                                                            ClipToBounds="True"
                                                            Height="30"
                                                            Width="30">
                                                            <Image
                                                                Height="30"
                                                                Source="{Binding Difficulty, Converter={x:Static converters:FuncValueConverters.DifficultyIconConverter}}"
                                                                Stretch="Uniform"
                                                                Width="30" />
                                                            <Border
                                                                Background="#99000000"
                                                                CornerRadius="4"
                                                                HorizontalAlignment="Center"
                                                                Padding="3,0"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    FontWeight="Bold"
                                                                    Foreground="White"
                                                                    HorizontalAlignment="Center"
                                                                    Text="{Binding Rating}"
                                                                    VerticalAlignment="Center" />
                                                            </Border>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Panel>
                                    </Button>

                                    <!--  Author (least prominent, above the title)  -->
                                    <TextBlock
                                        FontSize="11"
                                        MaxLines="1"
                                        Opacity="0.5"
                                        Text="{Binding Manifest.Meta.Author}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!--  Title -> web chart detail page (online charts only)  -->
                                    <Button
                                        Classes="Transparent"
                                        Command="{Binding $parent[UserControl].DataContext.OpenUrlCommand}"
                                        CommandParameter="{Binding ., Converter={x:Static converters:FuncValueConverters.ChartDetailUrlConverter}}"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"
                                        IsHitTestVisible="{Binding Source, Converter={x:Static converters:FuncValueConverters.ChartIsOnlineConverter}}"
                                        MinHeight="0"
                                        MinWidth="0"
                                        Padding="0"
                                        ToolTip.Tip="{Binding Manifest.Meta.Name}">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover TextBlock">
                                                <Setter Property="TextDecorations" Value="Underline" />
                                            </Style>
                                        </Button.Styles>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            Text="{Binding Manifest.Meta.Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <!--  Charters (all difficulties, de-duplicated; brighter than the author)  -->
                                    <TextBlock
                                        FontSize="12"
                                        IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        MaxLines="1"
                                        Opacity="0.7"
                                        Text="{Binding ., Converter={x:Static converters:FuncValueConverters.ChartChartersConverter}}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding $self.Text}" />

                                    <!--  Meta row: bpm + video tag  -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.85"
                                            Text="{Binding Manifest.Meta, Converter={x:Static converters:FuncValueConverters.ChartBpmConverter}, StringFormat='♪ {0}'}" />
                                        <Border
                                            Background="#40808080"
                                            CornerRadius="3"
                                            IsVisible="{Binding VideoPath, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Padding="5,1"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Opacity="0.85"
                                                Text="{Localize {x:Static loc:XAMLLiteral.ChartManage_Tag_Video}}" />
                                        </Border>
                                    </StackPanel>

                                    <!--  Uploader + size/delete sharing the right slot: size when idle, delete on card hover  -->
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        MinHeight="18">
                                        <Button
                                            Grid.Column="0"
                                            Classes="Transparent"
                                            Command="{Binding $parent[UserControl].DataContext.OpenUrlCommand}"
                                            CommandParameter="{Binding Manifest.Meta.Uploader, Converter={x:Static converters:FuncValueConverters.ChartUploaderUrlConverter}}"
                                            Cursor="Hand"
                                            HorizontalAlignment="Left"
                                            IsHitTestVisible="{Binding Source, Converter={x:Static converters:FuncValueConverters.ChartIsOnlineConverter}}"
                                            IsVisible="{Binding Manifest.Meta.Uploader, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            MinHeight="0"
                                            MinWidth="0"
                                            Padding="0"
                                            VerticalAlignment="Center">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover TextBlock">
                                                    <Setter Property="TextDecorations" Value="Underline" />
                                                </Style>
                                            </Button.Styles>
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="Normal"
                                                Foreground="{DynamicResource SemiColorText0}"
                                                Opacity="0.55"
                                                Text="{Binding Manifest.Meta.Uploader.Nickname, Converter={x:Static converters:FuncValueConverters.ChartUploaderConverter}}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <Panel
                                            Grid.Column="1"
                                            VerticalAlignment="Center">
                                        <!--  Size shown while idle; kept in layout (opacity, not visibility) so the slot width never jumps  -->
                                        <TextBlock
                                            Classes="sizeText"
                                            FontSize="11"
                                            HorizontalAlignment="Right"
                                            Opacity="0.55"
                                            Text="{Binding ., Converter={x:Static converters:FuncValueConverters.ChartSizeConverter}}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Command="{Binding $parent[UserControl].DataContext.RemoveChartCommand}"
                                            CommandParameter="{Binding}"
                                            Focusable="False"
                                            Height="18"
                                            HorizontalAlignment="Right"
                                            IsVisible="{Binding $parent[Border].IsPointerOver}"
                                            MinHeight="0"
                                            MinWidth="0"
                                            Padding="0"
                                            ToolTip.Tip="{Localize {x:Static loc:XAMLLiteral.ChartManage_Delete}}"
                                            VerticalAlignment="Center"
                                            Width="22">
                                            <Button.Styles>
                                                <Style Selector="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="Button:pointerover PathIcon">
                                                    <Setter Property="Foreground" Value="#F5333E" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </Style>
                                            </Button.Styles>
                                            <PathIcon
                                                Data="M6 19 c0 1.1 .9 2 2 2 h8 c1.1 0 2 -.9 2 -2 V7 H6 v12 z M19 4 h-3.5 l-1 -1 h-5 l-1 1 H5 v2 h14 V4 z"
                                                Height="13"
                                                Opacity="0.5"
                                                Width="13" />
                                        </Button>
                                        </Panel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
