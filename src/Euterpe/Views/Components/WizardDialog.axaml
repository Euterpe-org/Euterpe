<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Euterpe.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Euterpe.ViewModels.Components"
    x:Class="Euterpe.Views.Components.WizardDialog"
    x:DataType="vm:WizardDialogViewModel"
    d:DesignHeight="520"
    d:DesignWidth="850"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:WizardDialogViewModel />
    </Design.DataContext>

    <UserControl.Styles>

        <!--  Identity Card Base  -->
        <Style
            Selector="Border.IdentityCard">
            <Setter Property="Background" Value="{DynamicResource SecondaryCardColor}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition
                        Property="Background"
                        Duration="0:0:0.15" />
                    <BrushTransition
                        Property="BorderBrush"
                        Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <!--  Identity Card Hover  -->
        <Style
            Selector="Button:pointerover Border.IdentityCard">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        </Style>

        <!--  Identity Card Selected  -->
        <Style
            Selector="Border.IdentityCard.Selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiBlue5}" />
        </Style>

        <!--  Progress Bar  -->
        <Style
            Selector="ProgressBar.Wizard">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="12" />
            <Setter Property="MinHeight" Value="12" />
        </Style>
        <Style
            Selector="ProgressBar.Wizard /template/ Border">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Styles>

    <Grid
        Height="520"
        RowDefinitions="*,Auto"
        Width="850">

        <!--  Page 1: Identity Selection + Component Options  -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="340,*"
            IsVisible="{Binding !IsProgressPage}"
            Margin="28,24,28,0"
            RowDefinitions="Auto,*">

            <!--  Header  -->
            <StackPanel
                Grid.ColumnSpan="2"
                Margin="0,0,0,18"
                Spacing="4">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">
                    <Image
                        Height="36"
                        RenderOptions.BitmapInterpolationMode="HighQuality"
                        Source="/Assets/Logo.webp" />
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="Welcome to Euterpe"
                        Theme="{StaticResource TitleTextBlock}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    Foreground="{DynamicResource SecondaryTextColor}"
                    Margin="48,0,0,0"
                    Text="Choose your role and components to get started" />
            </StackPanel>

            <!--  Left: Identity Cards  -->
            <ItemsControl
                Grid.Row="1"
                Grid.Column="0"
                ItemsSource="{Binding IdentityOptions, Mode=OneTime}"
                Margin="0,0,12,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate
                        x:DataType="vm:WizardIdentityOption">
                        <Button
                            Classes="Transparent Card"
                            Command="{Binding $parent[UserControl].DataContext.SelectIdentityCommand, Mode=OneTime}"
                            CommandParameter="{Binding Identity, Mode=OneTime}"
                            Margin="0,0,0,6">
                            <Border
                                Classes="IdentityCard"
                                Classes.Selected="{Binding IsSelected, Mode=OneWay}">
                                <Grid
                                    ColumnDefinitions="Auto,*">

                                    <!--  Icon Badge  -->
                                    <Panel
                                        Height="30"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Width="30">
                                        <Border
                                            Background="{DynamicResource SemiBlue5}"
                                            CornerRadius="15"
                                            Opacity="0.12" />
                                        <PathIcon
                                            Data="{Binding IconKey, Converter={x:Static converters:FuncValueConverters.SemiIconConverter}, Mode=OneTime}"
                                            Foreground="{DynamicResource SemiBlue5}"
                                            Height="14" />
                                    </Panel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="1"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title, Mode=OneTime}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource SecondaryTextColor}"
                                            Text="{Binding Description, Mode=OneTime}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Right: Component Options  -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource SecondaryCardColor}"
                CornerRadius="10"
                Margin="12,0,0,0"
                Padding="20,16"
                Theme="{DynamicResource CardBorder}">
                <StackPanel
                    Spacing="4">

                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"
                        Text="Components"
                        Theme="{StaticResource TitleTextBlock}" />

                    <ItemsControl
                        ItemsSource="{Binding Components, Mode=OneTime}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate
                                x:DataType="vm:WizardComponent">
                                <CheckBox
                                    IsChecked="{Binding IsSelected}"
                                    Margin="0,2">
                                    <TextBlock
                                        Text="{Binding DisplayName, Mode=OneTime}" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Page 2: Progress  -->
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            IsVisible="{Binding IsProgressPage}"
            Spacing="8"
            VerticalAlignment="Center"
            Width="480">

            <!--  Logo  -->
            <Image
                Height="48"
                HorizontalAlignment="Center"
                Margin="0,0,0,12"
                RenderOptions.BitmapInterpolationMode="HighQuality"
                Source="/Assets/Logo.webp" />

            <!--  Title  -->
            <TextBlock
                FontSize="22"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Text="Setting Up Euterpe"
                Theme="{StaticResource TitleTextBlock}" />

            <!--  Current Task Description  -->
            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource SecondaryTextColor}"
                HorizontalAlignment="Center"
                Margin="0,4,0,16"
                Text="{Binding ProgressDescription, Mode=OneWay}" />

            <!--  Progress Bar  -->
            <ProgressBar
                Classes="Primary Wizard"
                MinWidth="360"
                Value="{Binding Progress, Mode=OneWay}" />

            <!--  Percentage  -->
            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource SecondaryTextColor}"
                HorizontalAlignment="Center"
                Text="{Binding Progress, StringFormat='{}{0:F0}%', Mode=OneWay}" />
        </StackPanel>

        <!--  Bottom Bar  -->
        <Border
            Grid.Row="1"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="28,15">
            <DockPanel>

                <!--  Selection Page: Skip  -->
                <Button
                    Command="{Binding SkipWizardCommand}"
                    Content="Skip"
                    DockPanel.Dock="Left"
                    IsVisible="{Binding !IsProgressPage}"
                    Theme="{StaticResource GhostButton}" />

                <!--  Selection Page: Confirm  -->
                <Button
                    Classes="Primary"
                    Command="{Binding ConfirmCommand}"
                    Content="Confirm"
                    DockPanel.Dock="Right"
                    IsVisible="{Binding !IsProgressPage}" />

                <Panel />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
