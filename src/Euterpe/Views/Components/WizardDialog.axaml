<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Euterpe.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Euterpe.ViewModels.Components"
    x:Class="Euterpe.Views.Components.WizardDialog"
    x:DataType="vm:WizardDialogViewModel"
    d:DesignHeight="480"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:WizardDialogViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style
            Selector="Border.IdentityCard">
            <Setter Property="Background" Value="{DynamicResource SecondaryCardColor}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition
                        Property="BorderBrush"
                        Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style
            Selector="Border.IdentityCard.Selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiBlue5}" />
        </Style>
    </UserControl.Styles>

    <Grid
        Height="480"
        RowDefinitions="*,Auto"
        Width="800">

        <!--  Page 1: Identity Selection + Component Options  -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="260,*"
            IsVisible="{Binding !IsProgressPage}"
            Margin="20,20,20,0">

            <!--  Left: Identity Cards  -->
            <StackPanel
                Grid.Column="0"
                Margin="0,0,10,0"
                Spacing="8">

                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"
                    Text="Choose Your Role"
                    Theme="{StaticResource TitleTextBlock}" />

                <ItemsControl
                    ItemsSource="{Binding IdentityOptions, Mode=OneTime}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate
                            x:DataType="vm:WizardIdentityOption">
                            <Button
                                Classes="Transparent Card"
                                Command="{Binding $parent[UserControl].DataContext.SelectIdentityCommand, Mode=OneTime}"
                                CommandParameter="{Binding Identity, Mode=OneTime}"
                                Margin="0,0,0,8">
                                <Border
                                    Classes="IdentityCard"
                                    Classes.Selected="{Binding IsSelected, Mode=OneWay}">
                                    <Grid
                                        ColumnDefinitions="Auto,*">
                                        <PathIcon
                                            Data="{Binding IconKey, Converter={x:Static converters:FuncValueConverters.SemiIconConverter}, Mode=OneTime}"
                                            Foreground="{DynamicResource SemiBlue5}"
                                            Height="20"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="2">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding Title, Mode=OneTime}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource SecondaryTextColor}"
                                                Text="{Binding Description, Mode=OneTime}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Right: Component Options  -->
            <StackPanel
                Grid.Column="1"
                Margin="10,0,0,0"
                Spacing="8">

                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"
                    Text="Components"
                    Theme="{StaticResource TitleTextBlock}" />

                <ItemsControl
                    ItemsSource="{Binding Components, Mode=OneTime}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate
                            x:DataType="vm:WizardComponent">
                            <CheckBox
                                Content="{Binding DisplayName, Mode=OneTime}"
                                IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!--  Page 2: Progress  -->
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            IsVisible="{Binding IsProgressPage}"
            Spacing="16"
            VerticalAlignment="Center"
            Width="450">

            <!--  Title  -->
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                IsVisible="{Binding !IsCompleted}"
                Text="Setting Up..."
                Theme="{StaticResource TitleTextBlock}" />

            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="Green"
                HorizontalAlignment="Center"
                IsVisible="{Binding IsCompleted}"
                Text="Setup Complete!"
                Theme="{StaticResource TitleTextBlock}" />

            <!--  Current Task Description  -->
            <TextBlock
                Foreground="{DynamicResource SecondaryTextColor}"
                HorizontalAlignment="Center"
                IsVisible="{Binding !IsCompleted}"
                Text="{Binding ProgressDescription, Mode=OneWay}" />

            <!--  Progress Bar  -->
            <ProgressBar
                Classes="Primary"
                IsVisible="{Binding !IsCompleted}"
                Margin="0,8,0,0"
                ShowProgressText="True"
                Value="{Binding Progress, Mode=OneWay}" />
        </StackPanel>

        <!--  Bottom Bar  -->
        <Border
            Grid.Row="1"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,15">
            <DockPanel>

                <!--  Selection Page: Skip  -->
                <Button
                    Command="{Binding SkipWizardCommand}"
                    Content="Skip"
                    DockPanel.Dock="Left"
                    IsVisible="{Binding !IsProgressPage}"
                    Theme="{StaticResource GhostButton}" />

                <!--  Selection Page: Confirm  -->
                <Button
                    Classes="Primary"
                    Command="{Binding ConfirmCommand}"
                    Content="Confirm"
                    DockPanel.Dock="Right"
                    IsVisible="{Binding !IsProgressPage}" />

                <!--  Progress Page: Close  -->
                <Button
                    Classes="Primary"
                    Command="{Binding CompleteCommand}"
                    Content="Close"
                    DockPanel.Dock="Right"
                    IsVisible="{Binding IsCompleted}" />

                <Panel />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
