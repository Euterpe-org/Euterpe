<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Euterpe.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Euterpe.ViewModels.Components"
    x:Class="Euterpe.Views.Components.WizardDialog"
    x:DataType="vm:WizardDialogViewModel"
    d:DesignHeight="520"
    d:DesignWidth="850"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:WizardDialogViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <!--  Identity Card: opacity overlay approach (no BrushTransition)  -->
        <ControlTheme
            x:Key="IdentityCardItem"
            TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <!--  Base card background  -->
                        <Border
                            x:Name="BaseBg"
                            Background="{DynamicResource SecondaryCardColor}"
                            CornerRadius="{TemplateBinding CornerRadius}" />

                        <!--  Hover overlay  -->
                        <Border
                            x:Name="HoverOverlay"
                            Background="#808080"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition
                                        Property="Opacity"
                                        Duration="0:0:0.15" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <!--  Selected overlay  -->
                        <Border
                            x:Name="SelectedOverlay"
                            Background="#2563EB"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition
                                        Property="Opacity"
                                        Duration="0:0:0.2" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <!--  Selected border  -->
                        <Border
                            x:Name="SelectedBorder"
                            BorderBrush="#2563EB"
                            BorderThickness="2"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition
                                        Property="Opacity"
                                        Duration="0:0:0.2" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <!--  Content  -->
                        <ContentPresenter
                            x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="10,8" />
                    </Grid>
                </ControlTemplate>
            </Setter>

            <!--  Hover: show hover overlay  -->
            <Style
                Selector="^:pointerover /template/ Border#HoverOverlay">
                <Setter Property="Opacity" Value="0.1" />
            </Style>

            <!--  Selected: show selected overlay + border, hide hover  -->
            <Style
                Selector="^:selected /template/ Border#SelectedOverlay">
                <Setter Property="Opacity" Value="0.7" />
            </Style>
            <Style
                Selector="^:selected /template/ Border#SelectedBorder">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style
                Selector="^:selected /template/ Border#HoverOverlay">
                <Setter Property="Opacity" Value="0" />
            </Style>

            <!--  Selected + Hover: keep selected appearance  -->
            <Style
                Selector="^:selected:pointerover /template/ Border#SelectedOverlay">
                <Setter Property="Opacity" Value="0.7" />
            </Style>
            <Style
                Selector="^:selected:pointerover /template/ Border#HoverOverlay">
                <Setter Property="Opacity" Value="0" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>

        <!--  Identity ListBox: remove default chrome  -->
        <Style
            Selector="ListBox.IdentityList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!--  Apply custom theme to all items  -->
        <Style
            Selector="ListBox.IdentityList ListBoxItem">
            <Setter Property="Theme" Value="{StaticResource IdentityCardItem}" />
        </Style>

        <!--  Selected foreground (descendant selectors not allowed in ControlTheme)  -->
        <Style
            Selector="ListBox.IdentityList ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style
            Selector="ListBox.IdentityList ListBoxItem:selected PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style
            Selector="ListBox.IdentityList ListBoxItem:selected Panel > Border">
            <Setter Property="Background" Value="White" />
        </Style>

        <!--  Progress Bar  -->
        <Style
            Selector="ProgressBar.Wizard">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="12" />
            <Setter Property="MinHeight" Value="12" />
        </Style>
        <Style
            Selector="ProgressBar.Wizard /template/ Border">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Styles>

    <Grid
        Height="520"
        RowDefinitions="*,Auto"
        Width="850">

        <!--  Page 1: Identity Selection + Component Options  -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="340,*"
            IsVisible="{Binding !IsProgressPage}"
            Margin="28,24,28,0"
            RowDefinitions="Auto,*">

            <!--  Header  -->
            <StackPanel
                Grid.ColumnSpan="2"
                Margin="0,0,0,18"
                Spacing="4">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">
                    <Image
                        Height="36"
                        RenderOptions.BitmapInterpolationMode="HighQuality"
                        Source="/Assets/Logo.webp" />
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Text="Welcome to Euterpe"
                        Theme="{StaticResource TitleTextBlock}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    Foreground="{DynamicResource SecondaryTextColor}"
                    Margin="48,0,0,0"
                    Text="Choose your role and components to get started" />
            </StackPanel>

            <!--  Left: Identity Cards  -->
            <ListBox
                Grid.Row="1"
                Grid.Column="0"
                Classes="IdentityList"
                ItemsSource="{Binding IdentityOptions, Mode=OneTime}"
                Margin="0,0,12,0"
                SelectedItem="{Binding SelectedIdentityOption}">
                <ListBox.ItemTemplate>
                    <DataTemplate
                        x:DataType="vm:WizardIdentityOption">
                        <Grid
                            ColumnDefinitions="Auto,*">

                            <!--  Icon Badge  -->
                            <Panel
                                Height="30"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Width="30">
                                <Border
                                    Background="{Binding AccentColor}"
                                    CornerRadius="15"
                                    Opacity="0.15" />
                                <PathIcon
                                    Data="{Binding IconKey, Converter={x:Static converters:FuncValueConverters.SemiIconConverter}, Mode=OneTime}"
                                    Foreground="{Binding AccentColor}"
                                    Height="14" />
                            </Panel>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{Binding Title, Mode=OneTime}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource SecondaryTextColor}"
                                    Text="{Binding Description, Mode=OneTime}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  Right: Component Options  -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource SecondaryCardColor}"
                CornerRadius="10"
                Margin="12,0,0,0"
                Padding="20,16"
                Theme="{DynamicResource CardBorder}">
                <DockPanel>

                    <TextBlock
                        DockPanel.Dock="Top"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Margin="0,0,0,12"
                        Text="Components"
                        Theme="{StaticResource TitleTextBlock}" />

                    <ScrollViewer>
                        <ItemsControl
                            ItemsSource="{Binding Components, Mode=OneTime}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate
                                    x:DataType="vm:WizardComponent">
                                    <CheckBox
                                        IsChecked="{Binding IsSelected}"
                                        Margin="0,2"
                                        Padding="0">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            Margin="4,0,0,0">
                                            <StackPanel
                                                Spacing="1"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13"
                                                    Text="{Binding DisplayName, Mode=OneTime}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource SecondaryTextColor}"
                                                    Text="{Binding Description, Mode=OneTime}" />
                                            </StackPanel>
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!--  Page 2: Progress  -->
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            IsVisible="{Binding IsProgressPage}"
            Spacing="8"
            VerticalAlignment="Center"
            Width="480">

            <!--  Logo  -->
            <Image
                Height="48"
                HorizontalAlignment="Center"
                Margin="0,0,0,12"
                RenderOptions.BitmapInterpolationMode="HighQuality"
                Source="/Assets/Logo.webp" />

            <!--  Title  -->
            <TextBlock
                FontSize="22"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Text="Setting Up Euterpe"
                Theme="{StaticResource TitleTextBlock}" />

            <!--  Current Task Description  -->
            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource SecondaryTextColor}"
                HorizontalAlignment="Center"
                Margin="0,4,0,16"
                Text="{Binding ProgressDescription, Mode=OneWay}" />

            <!--  Progress Bar  -->
            <ProgressBar
                Classes="Primary Wizard"
                MinWidth="360"
                Value="{Binding Progress, Mode=OneWay}" />

            <!--  Percentage  -->
            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource SecondaryTextColor}"
                HorizontalAlignment="Center"
                Text="{Binding Progress, StringFormat='{}{0:F0}%', Mode=OneWay}" />
        </StackPanel>

        <!--  Bottom Bar  -->
        <Border
            Grid.Row="1"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="28,15">
            <DockPanel>

                <!--  Selection Page: Skip  -->
                <Button
                    Command="{Binding SkipWizardCommand}"
                    Content="Skip"
                    DockPanel.Dock="Left"
                    IsVisible="{Binding !IsProgressPage}"
                    Theme="{StaticResource GhostButton}" />

                <!--  Selection Page: Confirm  -->
                <Button
                    Classes="Primary"
                    Command="{Binding ConfirmCommand}"
                    Content="Confirm"
                    DockPanel.Dock="Right"
                    IsVisible="{Binding !IsProgressPage}" />

                <Panel />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
