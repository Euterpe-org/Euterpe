<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Avalonia.Labs.Controls"
    xmlns:semi="https://irihi.tech/semi"
    xmlns:vm="using:Euterpe.ViewModels"
    x:Class="Euterpe.Views.App"
    x:DataType="vm:AppViewModel"
    RequestedThemeVariant="Dark">

    <Application.Styles>
        <StyleInclude
            Source="avares://Euterpe.Styles/ModToolsStyles.axaml" />
        <semi:SemiTheme />
        <semi:SemiPopupAnimations />
        <semi:UrsaSemiTheme />
        <controls:ControlThemes />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon
                Command="{Binding ShowCommand, Mode=OneTime}"
                Icon="/Assets/Icon.ico"
                ToolTipText="Euterpe">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem
                            Command="{Binding ShowCommand, Mode=OneTime}"
                            Header="Show" />
                        <NativeMenuItem
                            Command="{Binding ExitCommand, Mode=OneTime}"
                            Header="Exit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>