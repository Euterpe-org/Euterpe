<Project>
    <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile" Inputs="$(MSBuildAllProjects)" Outputs="$(IntermediateOutputPath)AssemblyInfo.cs">
        <ItemGroup>
            <_AvaloniaPackage Include="@(PackageVersion)"
                              Condition="'%(PackageVersion.Identity)' == 'Avalonia'"/>
        </ItemGroup>

        <PropertyGroup>
            <_AvaloniaVersion>@(_AvaloniaPackage->'%(Version)')</_AvaloniaVersion>
            <GeneratedText><![CDATA[
namespace $(RootNamespace)%3B
public static partial class BuildInfo
{
    public const string Company = "Euterpe-org"%3B
    public const string Copyright = "Copyright © 2023-$([System.DateTime]::Now.Year) Euterpe-org"%3B
    public const string Description = "A tool for Muse Dash modding"%3B
    public const string AppName = "Euterpe"%3B
    public const string AppVersion = "$(Version)"%3B
    public const string DisplayVersion = $"v{AppVersion}"%3B
    public const string DotNetVersion = "$(TargetFrameworkVersion)"%3B
    public const string AvaloniaVersion = "$(_AvaloniaVersion)"%3B
}
      ]]></GeneratedText>
            <GeneratedFilePath>$(IntermediateOutputPath)BuildInfo.g.cs</GeneratedFilePath>
        </PropertyGroup>

        <ItemGroup>
            <Compile Include="$(GeneratedFilePath)"/>
            <FileWrites Include="$(GeneratedFilePath)"/>
        </ItemGroup>

        <WriteLinesToFile Lines="$(GeneratedText)" File="$(GeneratedFilePath)" WriteOnlyWhenDifferent="true" Overwrite="true"/>
    </Target>
</Project>
