<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Log Container  -->
    <Style
        Selector="Border.LogContainer">
        <Setter Property="Background" Value="{DynamicResource SecondaryCardColor}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Margin" Value="0,0,10,10" />
    </Style>

    <!--  Log ListBox - remove default chrome  -->
    <Style
        Selector="ListBox.LogList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!--  ListBoxItem - subtle hover  -->
    <Style
        Selector="ListBox.LogList ListBoxItem">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition
                    Property="Background"
                    Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style
        Selector="ListBox.LogList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style
        Selector="ListBox.LogList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#10FFFFFF" />
    </Style>
    <Style
        Selector="ListBox.LogList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#18FFFFFF" />
    </Style>

    <!--  Log Entry Grid  -->
    <Style
        Selector="Grid.LogEntry">
        <Setter Property="Margin" Value="0" />
    </Style>

    <!--  Timestamp  -->
    <Style
        Selector="TextBlock.LogTimestamp">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Level Badge Base  -->
    <Style
        Selector="Border.LogLevelBadge">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Level Badge Text  -->
    <Style
        Selector="TextBlock.LogLevelText">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Level Badge Colors  -->
    <Style
        Selector="Border.LogLevelBadge.TRC">
        <Setter Property="Background" Value="#20808080" />
        <Style
            Selector="^ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
        </Style>
    </Style>
    <Style
        Selector="Border.LogLevelBadge.DBG">
        <Setter Property="Background" Value="#2054A9FF" />
        <Style
            Selector="^ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiBlue5}" />
        </Style>
    </Style>
    <Style
        Selector="Border.LogLevelBadge.INF">
        <Setter Property="Background" Value="#2050C8A8" />
        <Style
            Selector="^ TextBlock">
            <Setter Property="Foreground" Value="#50C8A8" />
        </Style>
    </Style>
    <Style
        Selector="Border.LogLevelBadge.WRN">
        <Setter Property="Background" Value="#25F0B040" />
        <Style
            Selector="^ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiYellow5}" />
        </Style>
    </Style>
    <Style
        Selector="Border.LogLevelBadge.ERR">
        <Setter Property="Background" Value="#25F05050" />
        <Style
            Selector="^ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiRed5}" />
        </Style>
    </Style>
    <Style
        Selector="Border.LogLevelBadge.CRT">
        <Setter Property="Background" Value="#25C060F0" />
        <Style
            Selector="^ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiPurple5}" />
        </Style>
    </Style>

    <!--  Message Text  -->
    <Style
        Selector="TextBlock.LogMessage">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>