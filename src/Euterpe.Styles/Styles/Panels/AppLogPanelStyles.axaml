<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style
        Selector="TextBlock">
        <Style
            Selector="^.TRC">
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey5}" />
        </Style>
        <Style
            Selector="^.DBG">
            <Setter Property="Foreground" Value="{DynamicResource SemiBlue5}" />
        </Style>
        <Style
            Selector="^.INF">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        </Style>
        <Style
            Selector="^.WRN">
            <Setter Property="Foreground" Value="{DynamicResource SemiYellow5}" />
        </Style>
        <Style
            Selector="^.ERR">
            <Setter Property="Foreground" Value="{DynamicResource SemiRed5}" />
        </Style>
        <Style
            Selector="^.CRT">
            <Setter Property="Foreground" Value="{DynamicResource SemiPurple5}" />
        </Style>
    </Style>

</Styles>