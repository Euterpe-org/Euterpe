<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Support Card Container  -->
    <Style Selector="Border.SupportCard">
        <Setter Property="Padding" Value="20" />
        <Setter Property="MaxWidth" Value="340" />
        <Setter Property="Opacity" Value="0.95" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="ExponentialEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.2" Easing="ExponentialEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.SupportCard:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!--  Support Emoji  -->
    <Style Selector="TextBlock.SupportEmoji">
        <Setter Property="FontSize" Value="17" />
    </Style>

    <!--  Support Title Text  -->
    <Style Selector="TextBlock.SupportTitle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTitleColor}" />
    </Style>

    <!--  Support Description Text  -->
    <Style Selector="TextBlock.SupportDescription">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="DarkGray" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!--  Support Close Button  -->
    <Style Selector="Button.SupportCloseButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="LinearEasing" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.SupportCloseButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.SupportCloseButton TextBlock">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="LinearEasing" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.SupportCloseButton:pointerover TextBlock">
        <Setter Property="Opacity" Value="1" />
    </Style>

</Styles>