<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Bitmaps  -->
    <Bitmap
        x:Key="AppTitleImage">
        avares://Euterpe/Assets/Title-Light.webp
    </Bitmap>
    <Bitmap
        x:Key="BackgroundImage">
        avares://Euterpe/Assets/Background-Light.webp
    </Bitmap>
    <Bitmap
        x:Key="TitleImage">
        avares://Euterpe/Assets/MDMC_Title_Light.webp
    </Bitmap>

    <!--  Colors  -->
    <Color
        x:Key="SecondaryCardColor">
        #EDF2F7
    </Color>
    <Color
        x:Key="PrimaryTitleColor">
        #1A365D
    </Color>
    <Color
        x:Key="SecondaryTextColor">
        #4A5568
    </Color>

    <!--  Override Semi Design Global Background Colors  -->
    <Color
        x:Key="SemiGrey0">
        #F0F4F8
    </Color>
    <SolidColorBrush
        x:Key="CardBackground">
        #F8FAFB
    </SolidColorBrush>
    <SolidColorBrush
        x:Key="BorderBrush">
        #E1E8ED
    </SolidColorBrush>
    <SolidColorBrush
        x:Key="RegionBrush">
        #F0F4F8
    </SolidColorBrush>
    <SolidColorBrush
        x:Key="ControlFillColorDefaultBrush">
        #F8FAFB
    </SolidColorBrush>

</ResourceDictionary>