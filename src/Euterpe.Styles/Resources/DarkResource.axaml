<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Bitmaps  -->
    <Bitmap
        x:Key="AppTitleImage">
        avares://Euterpe/Assets/Title-Dark.webp
    </Bitmap>
    <Bitmap
        x:Key="BackgroundImage">
        avares://Euterpe/Assets/Background-Dark.webp
    </Bitmap>
    <Bitmap
        x:Key="TitleImage">
        avares://Euterpe/Assets/MDMC_Title_Dark.webp
    </Bitmap>

    <!--  Colors  -->
    <Color
        x:Key="SecondaryCardColor">
        #1F2024
    </Color>
    <Color
        x:Key="PrimaryTitleColor">
        #FAFAFA
    </Color>
    <Color
        x:Key="SecondaryTextColor">
        #9CA3AF
    </Color>

</ResourceDictionary>