<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style
        Selector="Border">

        <!--  QR Code Container Style  -->
        <Style
            Selector="^.DialogDonationQr">
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="170" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BoxShadow" Value="0 2 8 #20000000" />
        </Style>

        <!--  PayPal Card Style  -->
        <Style
            Selector="^.DialogDonationCard">
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="170" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Background" Value="#0070ba" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BoxShadow" Value="0 2 8 #20000000" />
        </Style>

    </Style>

    <!--  Unified Image Style  -->
    <Style
        Selector="Image">
        <Style
            Selector="^.DialogDonationQr">
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="170" />
            <Setter Property="Stretch" Value="UniformToFill" />
        </Style>
    </Style>

    <!--  Unified Hyperlink Style  -->
    <Style
        Selector="HyperlinkButton">
        <Style
            Selector="^.PaypalButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Style>

</Styles>
