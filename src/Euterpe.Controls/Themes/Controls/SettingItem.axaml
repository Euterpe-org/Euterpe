<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:e="https://github.com/Euterpe-org/Euterpe">

    <Design.PreviewWith>
        <e:SettingItem
            Description="Description"
            Title="Setting">
            <TextBox
                Text="Content" />
        </e:SettingItem>
    </Design.PreviewWith>

    <Style
        Selector="e|SettingItem">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel
                    Orientation="Vertical"
                    Spacing="15">

                    <TextBlock
                        Classes="H4"
                        Text="{TemplateBinding Title, Mode=OneWay}"
                        Theme="{StaticResource TitleTextBlock}" />

                    <TextBlock
                        Foreground="Gray"
                        IsVisible="{TemplateBinding Description, Converter={x:Static ObjectConverters.IsNotNull}, Mode=OneWay}"
                        Margin="0,-10,0,0"
                        Text="{TemplateBinding Description, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <ContentPresenter
                        Content="{TemplateBinding Content, Mode=OneWay}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>