<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Bitmaps  -->
    <Bitmap
        x:Key="AppTitleImage">
        avares://Euterpe/Assets/Title-Dark.webp
    </Bitmap>

    <!--  Home Page  -->
    <!--  Sits over the shared background and stands in for what used to be a second, pre-darkened copy of it  -->
    <LinearGradientBrush x:Key="HomeScrimBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#CC16181C" />
        <GradientStop Offset="1" Color="#7316181C" />
    </LinearGradientBrush>
    <!--  The title is a neon logo drawn for dark ground and already clears 9.9:1 on this scrim, so its edge is
          switched off rather than removed: the light theme needs one, and both themes read the same key.  -->
    <DropShadowEffect
        x:Key="HomeTitleEffect"
        BlurRadius="0"
        Color="Transparent"
        OffsetX="0"
        OffsetY="0" />

    <!--  General Colors  -->
    <Color
        x:Key="SecondaryCardColor">
        #1F2024
    </Color>
    <Color
        x:Key="PrimaryTitleColor">
        #FAFAFA
    </Color>
    <Color
        x:Key="SecondaryTextColor">
        #9CA3AF
    </Color>

    <!--  Button Colors  -->
    <Color
        x:Key="PrimaryButtonStart">
        #54A9FF
    </Color>
    <Color
        x:Key="PrimaryButtonEnd">
        #7FC1FF
    </Color>
    <Color
        x:Key="PrimaryButtonHoverStart">
        #7FC1FF
    </Color>
    <Color
        x:Key="PrimaryButtonHoverEnd">
        #A1D4FF
    </Color>
    <Color
        x:Key="PrimaryButtonPressedStart">
        #4096FF
    </Color>
    <Color
        x:Key="PrimaryButtonPressedEnd">
        #54A9FF
    </Color>
    <Color
        x:Key="SecondaryButtonStart">
        #4096FF
    </Color>
    <Color
        x:Key="SecondaryButtonEnd">
        #54A9FF
    </Color>
    <Color
        x:Key="SecondaryButtonHoverStart">
        #54A9FF
    </Color>
    <Color
        x:Key="SecondaryButtonHoverEnd">
        #7FC1FF
    </Color>
    <Color
        x:Key="SecondaryButtonPressedStart">
        #2B7AD2
    </Color>
    <Color
        x:Key="SecondaryButtonPressedEnd">
        #4096FF
    </Color>

    <!--  Flyout Colors  -->
    <Color
        x:Key="FlyoutBackground">
        #1F2024
    </Color>
    <Color
        x:Key="FlyoutBorder">
        #2A2D33
    </Color>
    <Color
        x:Key="FlyoutItemHoverBackground">
        #2B2F36
    </Color>
    <Color
        x:Key="FlyoutItemSelectedBackground">
        #343A45
    </Color>
    <Color
        x:Key="FlyoutForeground">
        #FAFAFA
    </Color>
    <Color
        x:Key="FlyoutIconForeground">
        #FAFAFA
    </Color>

</ResourceDictionary>