<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Bitmaps  -->
    <Bitmap
        x:Key="AppTitleImage">
        avares://Euterpe/Assets/Title-Light.webp
    </Bitmap>

    <!--  Home Page  -->
    <!--  Sits over the shared background and stands in for what used to be a second, pre-lightened copy of it  -->
    <LinearGradientBrush x:Key="HomeScrimBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#D9F8FAFB" />
        <GradientStop Offset="1" Color="#8CF8FAFB" />
    </LinearGradientBrush>
    <!--  The title's cyan half only reaches 1.75:1 on this ground, so each glyph is given its own dark edge  -->
    <DropShadowEffect
        x:Key="HomeTitleEffect"
        BlurRadius="2"
        Color="Black"
        OffsetX="0"
        OffsetY="0" />

    <!--  General Colors  -->
    <Color
        x:Key="SecondaryCardColor">
        #EDF2F7
    </Color>
    <Color
        x:Key="PrimaryTitleColor">
        #1A365D
    </Color>
    <Color
        x:Key="SecondaryTextColor">
        #4A5568
    </Color>

    <!--  Button Colors  -->
    <Color
        x:Key="PrimaryButtonStart">
        #3B8BFF
    </Color>
    <Color
        x:Key="PrimaryButtonEnd">
        #66B1FF
    </Color>
    <Color
        x:Key="PrimaryButtonHoverStart">
        #59A6FF
    </Color>
    <Color
        x:Key="PrimaryButtonHoverEnd">
        #7EC0FF
    </Color>
    <Color
        x:Key="PrimaryButtonPressedStart">
        #2F78E6
    </Color>
    <Color
        x:Key="PrimaryButtonPressedEnd">
        #3B8BFF
    </Color>
    <Color
        x:Key="SecondaryButtonStart">
        #2F78E6
    </Color>
    <Color
        x:Key="SecondaryButtonEnd">
        #3B8BFF
    </Color>
    <Color
        x:Key="SecondaryButtonHoverStart">
        #3B8BFF
    </Color>
    <Color
        x:Key="SecondaryButtonHoverEnd">
        #59A6FF
    </Color>
    <Color
        x:Key="SecondaryButtonPressedStart">
        #286AD8
    </Color>
    <Color
        x:Key="SecondaryButtonPressedEnd">
        #2F78E6
    </Color>

    <!--  Flyout Colors  -->
    <Color
        x:Key="FlyoutBackground">
        #F8FAFB
    </Color>
    <Color
        x:Key="FlyoutBorder">
        #E1E8ED
    </Color>
    <Color
        x:Key="FlyoutItemHoverBackground">
        #E6EEF8
    </Color>
    <Color
        x:Key="FlyoutItemSelectedBackground">
        #D8E7FB
    </Color>
    <Color
        x:Key="FlyoutForeground">
        #1A365D
    </Color>
    <Color
        x:Key="FlyoutIconForeground">
        #1A365D
    </Color>

</ResourceDictionary>