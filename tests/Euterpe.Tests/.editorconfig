[*.cs]
dotnet_diagnostic.CA1859.severity = none

# ZLogger's ZLog* overloads take an [InterpolatedStringHandlerArgument]; the $"" is required, not wasteful.
dotnet_diagnostic.RCS1214.severity = none

# Namespaces are managed by Rider's NamespaceProvider (.csproj.DotSettings), not by folder matching.
dotnet_style_namespace_match_folder = false
