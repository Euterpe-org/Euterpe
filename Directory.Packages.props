<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <!-- Package Group Versions -->
    <PropertyGroup>
        <AvaloniaVersion>12.0.5</AvaloniaVersion>
        <MicrosoftCodeAnalysisVersion>5.3.0</MicrosoftCodeAnalysisVersion>
        <RefitVersion>12.0.0</RefitVersion>
        <R3Version>1.3.1</R3Version>
        <RoslynatorAnalyzersVersion>4.15.0</RoslynatorAnalyzersVersion>
        <TUnitVersion>1.56.35</TUnitVersion>
        <UrsaVersion>2.0.1</UrsaVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="AsmResolver.DotNet" Version="6.0.0"/>
        <PackageVersion Include="AssetsTools.NET" Version="3.0.4"/>
        <PackageVersion Include="AsyncAwaitBestPractices" Version="10.0.0"/>
        <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.1"/>
        <PackageVersion Include="Avalonia.Labs.Gif" Version="12.0.2"/>
        <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.9"/>
        <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)"/>
        <PackageVersion Include="Autofac" Version="9.3.0"/>
        <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3"/>
        <PackageVersion Include="CliWrap" Version="3.10.2"/>
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageVersion Include="ConsoleAppFramework" Version="5.7.13"/>
        <PackageVersion Include="DotNext.Threading" Version="6.4.0"/>
        <PackageVersion Include="Downloader" Version="5.9.0"/>
        <PackageVersion Include="DynamicData" Version="9.4.31"/>
        <PackageVersion Include="HotAvalonia" Version="3.1.2"/>
        <PackageVersion Include="Irihi.Ursa" Version="$(UrsaVersion)"/>
        <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="$(UrsaVersion)"/>
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0"/>
        <PackageVersion Include="MessagePack" Version="3.1.7"/>
        <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.7.1"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="$(MicrosoftCodeAnalysisVersion)"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.9"/>
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0"/>
        <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5"/>
        <PackageVersion Include="NetEscapades.EnumGenerators" Version="1.0.0-beta21"/>
        <PackageVersion Include="ObservableCollections" Version="3.3.4"/>
        <PackageVersion Include="Polyfill" Version="10.11.0"/>
        <PackageVersion Include="PublishAotCompressed" Version="1.0.5"/>
        <PackageVersion Include="R3" Version="$(R3Version)"/>
        <PackageVersion Include="R3Extensions.Avalonia" Version="$(R3Version)"/>
        <PackageVersion Include="Refit" Version="$(RefitVersion)"/>
        <PackageVersion Include="Refit.HttpClientFactory" Version="$(RefitVersion)"/>
        <PackageVersion Include="ResXLocalize.Avalonia.R3" Version="2.0.0"/>
        <PackageVersion Include="Riok.Mapperly" Version="4.3.1"/>
        <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="$(RoslynatorAnalyzersVersion)"/>
        <PackageVersion Include="Semi.Avalonia" Version="12.0.3"/>
        <PackageVersion Include="Semver" Version="3.0.0"/>
        <PackageVersion Include="SoundFlow" Version="1.4.1"/>
        <PackageVersion Include="SoundFlow.Codecs.FFMpeg" Version="1.4.0"/>
        <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.9"/>
        <PackageVersion Include="TUnit" Version="$(TUnitVersion)"/>
        <PackageVersion Include="TUnit.Mocks" Version="$(TUnitVersion)"/>
        <PackageVersion Include="TUnit.Mocks.Http" Version="$(TUnitVersion)"/>
        <PackageVersion Include="TUnit.Mocks.Logging" Version="$(TUnitVersion)"/>
        <PackageVersion Include="ValveKeyValue" Version="0.70.0.499"/>
        <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0"/>
        <PackageVersion Include="Verify.TUnit" Version="31.20.0"/>
        <PackageVersion Include="Xaml.Behaviors.Interactions.DragAndDrop" Version="12.0.0.1"/>
        <PackageVersion Include="ZLogger" Version="2.5.10"/>
        <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.98"/>
        <GlobalPackageReference Include="Roslynator.Analyzers" Version="$(RoslynatorAnalyzersVersion)"/>
        <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="$(RoslynatorAnalyzersVersion)"/>
    </ItemGroup>
</Project>